{
  "default_stop_words": [
    "defmodule",
    "defimpl",
    "defstruct",
    "def",
    "defp",
    "defmacrop",
    "defmacro",
    "defguard",
    "defguardp"
  ],
  "custom_stop_words": [],
  "skip_files": [
    "test/",
    "lib/luanox/application.ex"
  ],
  "coverage_options": {
    "treat_no_relevant_lines_as_covered": true,
    "output_dir": "cover/",
    "minimum_coverage": 0
  }
}
